/**
 * Harbor — Cloudflare Containers Worker.
 *
 * The Worker is a thin HTTP/WebSocket proxy. The Express app (+ built
 * Vite SPA) runs inside the container image built from ./Dockerfile.
 * See docs/CLOUDFLARE.md for secrets, Neon/Upstash, BYOA, and the
 * raft.is-a-nice.app custom domain (zone is-a-nice.app).
 *
 * Docs: https://developers.cloudflare.com/containers/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "harbor",
	"main": "workers/harbor/src/index.ts",
	"compatibility_date": "2026-08-17",
	"workers_dev": true,
	"routes": [
		{ "pattern": "raft.is-a-nice.app", "custom_domain": true },
	],
	"observability": {
		"enabled": true,
	},
	"containers": [
		{
			"class_name": "HarborContainer",
			"image": "./Dockerfile",
			// `basic` = 1/4 vCPU, 1 GiB RAM, 4 GB disk.
			// Chosen over `standard-1` (4 GiB): this image is a single Node
			// Express + ws process with Postgres/Redis *outside* the container.
			// GKE prod requests 512 MiB (limit 2 GiB) *including* kubectl and
			// agent-pod orchestration, which Cloudflare does not run. `lite`
			// (256 MiB) is too tight for Node + a 20-client pg pool. Bump to
			// `standard-1` if RSS approaches 1 GiB (large WS fan-out / JSON).
			"instance_type": "basic",
			// One Express process. Redis pub/sub is still required (the server
			// uses it in-process even with a single replica).
			"max_instances": 1,
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "HARBOR",
				"class_name": "HarborContainer",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["HarborContainer"],
		},
	],
	// Names only — values are set with `npx wrangler secret put <NAME>`
	// (interactive; do not commit values). Optional secrets (OAuth, R2,
	// Resend, …) are listed in docs/CLOUDFLARE.md and can be put the same
	// way; they are forwarded into the container when present.
	"secrets": {
		"required": [
			"DATABASE_URL",
			"REDIS_URL",
			"OPENAI_API_KEY",
			"AGENT_RUNTIME_SECRET",
		],
	},
	// Non-secret public origin. Set at deploy time so OAuth redirect_uri
	// / invite / pairing links match the public hostname. Intended
	// production origin is https://raft.is-a-nice.app; workers.dev
	// (https://harbor.penouc.workers.dev) remains a fallback. Do not
	// bake the value into committed vars.
	// "vars": {
	//   "CUMORA_PUBLIC_ORIGIN": "https://raft.is-a-nice.app"
	// }
	//
	// Optional OpenAI-compatible provider. Empty OPENAI_BASE_URL = SDK
	// default (api.openai.com). Do NOT bake a provider URL or model id
	// into committed vars — set at deploy time, e.g. DeepSeek V4:
	//   OPENAI_BASE_URL=https://api.deepseek.com
	//   OPENAI_MODEL=deepseek-v4-pro
	//   OPENAI_MODEL_SUPPORT=deepseek-v4-flash
	//   OPENAI_COMPACTION_MODEL=deepseek-v4-flash
	// OPENAI_API_KEY stays a required secret (that provider's key).
}
